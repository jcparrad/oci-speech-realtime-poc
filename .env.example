# Copy manually to .env. Only the local backend reads that personal file.
# Relative paths are resolved from this app root, not the shell cwd.
OCI_CONFIG_FILE=.secrets/oci/config
# Match the single complete profile in your personal config; SPEECH_POC is an example.
OCI_CONFIG_PROFILE=SPEECH_POC
OCI_REGION=sa-bogota-1
OCI_COMPARTMENT_ID=REEMPLAZAR_CON_OCID_DEL_COMPARTIMENTO

# Never put a private key, passphrase or Speech token here.
